<div style="width=90%; text-align: center; max-width: 160px; margin: 0 auto 1rem;">
  {%- if user.homepage -%}
    <a href="{{ user.homepage }}" target="_blank" rel="noopener">
  {%- endif -%}

  {% include figure.liquid 
    loading="eager" 
    path=user.figure 
    class='img-fluid z-depth-1 rounded-circle mb-0' 
    max-width="100px" 
    alt=user.name 
    cache_bust=true 
  %}

  {%- if user.homepage -%}
    </a>
  {%- endif -%}

<div>
  {%- if user.homepage -%}
    <div><a href="{{ user.homepage }}" target="_blank" rel="noopener">{{ user.name }}</a></div>
  {%- else -%}
    <div>{{ user.name }}</div>
  {%- endif -%}
  <div>{{ user.role }}</div>
</div>

<div>
  {%- if user.homepage -%}
      <a href="{{ user.homepage }}" title="Homepage" class="icon-link">
      <i class="fas fa-globe"></i>
      </a>
  {%- endif -%}
  {%- if user.email -%}
      <a href="mailto:{{ user.email }}" title="Email" class="icon-link">
      <i class="fas fa-envelope"></i>
      </a>
  {%- endif -%}
</div>

</div>



<style>
.icon-link {
  margin-right: 5px;
  text-decoration: none;
  border: none;
  color: inherit;
}

.icon-link:hover {
  color: #0076df;
  text-decoration: none;
}
</style>